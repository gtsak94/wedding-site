# Αντίγραψε αυτό το αρχείο σε .env.local και συμπλήρωσε τις τιμές.
# Τις βρίσκεις: Supabase → Project → Settings → API

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (ΜΥΣΤΙΚΟ — μόνο server-side)

# Μυστικό για τη σελίδα /admin (βάλε ό,τι θες)
ADMIN_KEY=changeme

# Το Dropbox File Request link (το φτιάχνει ο γαμπρός στον λογαριασμό του)
DROPBOX_REQUEST_URL=https://www.dropbox.com/request/REPLACE_ME

# Χρησιμοποιείται από το seed script για να φτιάξει τα links.
# Τοπικά: http://localhost:3000  ·  Live: https://to-domain-sou.gr
SITE_BASE_URL=http://localhost:3000
